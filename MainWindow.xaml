<Window x:Class="OPoptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:OPoptimizer.Models"
        Title="OPoptimizer • Gaming &amp; System Optimizer"
        Width="1240" Height="790" MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BaseBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT NAVIGATION -->
        <Border Background="#0C1626" BorderBrush="#26354B" BorderThickness="0,0,1,0">
            <Grid Margin="18,24,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="12" Background="#176AF2">
                        <TextBlock Text="OP" FontSize="17" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,2,0,0">
                        <TextBlock Text="OPoptimizer" FontWeight="Bold" FontSize="19" Foreground="White" />
                        <TextBlock Text="GAMING OPTIMIZER" FontSize="10" Foreground="#70A6FF" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="HERRAMIENTAS" FontSize="11" FontWeight="Bold" Foreground="#6886A9" Margin="13,0,0,18" />
                    <Button x:Name="NavDashboard" Style="{StaticResource NavButton}" Click="NavDashboard_Click" Content="⌂    Inicio" />
                    <Button x:Name="NavClean" Style="{StaticResource NavButton}" Click="NavClean_Click" Content="◈    Limpieza" />
                    <Button x:Name="NavGames" Style="{StaticResource NavButton}" Click="NavGames_Click" Content="▣    Mis juegos" />
                    <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Click="NavSettings_Click" Content="⚙    Ajustes" />
                    <Border Background="#14243C" BorderBrush="#263F62" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,33,0,0">
                        <StackPanel>
                            <TextBlock Text="●  TODO BAJO CONTROL" Foreground="#70B6FF" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="Sin anuncios, sin suscripciones y sin cambios ocultos." TextWrapping="Wrap" Foreground="#B3C7DE" FontSize="12" Margin="0,9,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="10,0,0,0">
                    <TextBlock Text="OPEN SOURCE · LICENCIA MIT" Foreground="#6481A2" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="Versión 1.2.0" Foreground="#9BB0CB" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="89" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>
            <Border BorderBrush="#24364B" BorderThickness="0,0,0,1" Padding="30,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Style="{StaticResource TitleText}" Text="Panel principal" />
                        <TextBlock x:Name="PageSubTitle" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" Text="Estado de tu PC en tiempo real" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#102D46" BorderBrush="#234C6B" BorderThickness="1" CornerRadius="18" Padding="12,7" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#42CFF4" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <TextBlock Text="Windows listo" Foreground="#A8DEFF" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- DASHBOARD -->
            <ScrollViewer x:Name="DashboardPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="30,22,30,25">
                    <Border CornerRadius="17" Padding="28" BorderThickness="1" BorderBrush="#2864AD">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#143C79" Offset="0" />
                                <GradientStop Color="#11233E" Offset="0.73" />
                                <GradientStop Color="#101D30" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="TU PC, A OTRO NIVEL" Foreground="#7AB8FF" FontWeight="Bold" FontSize="11" />
                                <TextBlock Text="Rendimiento sin complicaciones." FontWeight="Bold" FontSize="25" Foreground="White" Margin="0,9,0,8" />
                                <TextBlock Text="Analizá archivos temporales y elegí qué limpiar. Sin borrar partidas ni instalaciones." Foreground="#C2D6F2" FontSize="13" TextWrapping="Wrap" MaxWidth="520" />
                                <Button Style="{StaticResource PrimaryButton}" Content="⚡  ANALIZAR Y OPTIMIZAR" HorizontalAlignment="Left" Margin="0,19,0,0" Click="StartAnalyze_Click" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="116" Height="116" Background="#1A539D" CornerRadius="58" BorderBrush="#4385D6" BorderThickness="2" Margin="20,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="OP" FontWeight="ExtraBold" FontSize="42" Foreground="#D8EDFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock Text="MONITOREO DEL SISTEMA" FontWeight="Bold" Foreground="#A6B9D2" FontSize="12" Margin="0,27,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <TextBlock Text="PROCESADOR · CPU" Foreground="#95AAC5" FontSize="11" FontWeight="Bold" />
                                <TextBlock x:Name="CpuValue" Text="—" Foreground="White" FontSize="33" FontWeight="Bold" Margin="0,7,0,8" />
                                <ProgressBar x:Name="CpuProgress" Minimum="0" Maximum="100" Value="0" />
                                <TextBlock Text="Uso actual" Style="{StaticResource SecondaryText}" Margin="0,11,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <TextBlock Text="MEMORIA · RAM" Foreground="#95AAC5" FontSize="11" FontWeight="Bold" />
                                <TextBlock x:Name="RamValue" Text="—" Foreground="White" FontSize="33" FontWeight="Bold" Margin="0,7,0,8" />
                                <ProgressBar x:Name="RamProgress" Minimum="0" Maximum="100" Value="0" />
                                <TextBlock x:Name="RamDetail" Text="Calculando..." Style="{StaticResource SecondaryText}" Margin="0,11,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <TextBlock Text="DISCO DEL SISTEMA" Foreground="#95AAC5" FontSize="11" FontWeight="Bold" />
                                <TextBlock x:Name="DiskValue" Text="—" Foreground="White" FontSize="33" FontWeight="Bold" Margin="0,7,0,8" />
                                <ProgressBar x:Name="DiskProgress" Minimum="0" Maximum="100" Value="0" />
                                <TextBlock x:Name="DiskDetail" Text="Calculando..." Style="{StaticResource SecondaryText}" Margin="0,11,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="ACCESOS RÁPIDOS" FontWeight="Bold" Foreground="#A6B9D2" FontSize="12" Margin="0,26,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <TextBlock Text="◈  Limpieza inteligente" FontSize="17" FontWeight="Bold" Foreground="#E9F2FF" />
                                <TextBlock Text="Escaneá archivos antiguos, revisá el tamaño y confirmá antes de eliminar." Style="{StaticResource SecondaryText}" Margin="0,9,0,15" />
                                <Button Style="{StaticResource BaseButton}" Content="Ver limpieza" HorizontalAlignment="Left" Click="GoClean_Click" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <TextBlock Text="▣  Biblioteca gaming" FontSize="17" FontWeight="Bold" Foreground="#E9F2FF" />
                                <TextBlock Text="Detectá juegos de Steam, Epic, Minecraft y Roblox, sin modificarlos." Style="{StaticResource SecondaryText}" Margin="0,9,0,15" />
                                <Button Style="{StaticResource BaseButton}" Content="Ver mis juegos" HorizontalAlignment="Left" Click="GoGames_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- CLEANER -->
            <ScrollViewer x:Name="CleanPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="30,22,30,25">
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Limpieza bajo tu control" FontSize="21" FontWeight="Bold" />
                            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,17" Text="Primero analizamos. Después elegís las categorías y confirmás qué borrar. No se eliminan juegos ni partidas." />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnAnalyze" Style="{StaticResource PrimaryButton}" Content="↻  Analizar archivos" Click="Analyze_Click" />
                                <Button x:Name="BtnClean" Style="{StaticResource BaseButton}" Content="Limpiar seleccionados" Margin="11,0,0,0" IsEnabled="False" Click="Clean_Click" />
                            </StackPanel>
                            <TextBlock x:Name="CleanupStatus" Text="Todavía no se realizó un análisis." Foreground="#8FB6E5" FontSize="12" Margin="0,13,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="RESULTADOS DEL ANÁLISIS" FontWeight="Bold" Foreground="#A6B9D2" FontSize="12" Margin="0,24,0,12" />
                    <ItemsControl x:Name="CleanupGroupsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:CleanupGroup}">
                                <Border Style="{StaticResource PanelCard}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Foreground="#9DB0CA" FontSize="12" TextWrapping="Wrap" Margin="25,8,14,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="#73B7FF" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="⚠  Los archivos seleccionados se eliminan permanentemente. Las carpetas no se borran; los archivos en uso se omiten." Style="{StaticResource SecondaryText}" Margin="3,12,0,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- GAME LIBRARY -->
            <ScrollViewer x:Name="GamesPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="30,22,30,25">
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Tus juegos instalados" FontSize="21" FontWeight="Bold" />
                            <TextBlock Text="Reconocemos bibliotecas de Steam y Epic, además de carpetas habituales de Roblox y Minecraft. Es una exploración de solo lectura." Style="{StaticResource SecondaryText}" Margin="0,7,0,17" />
                            <Button x:Name="BtnScanGames" Content="⌕  Buscar juegos" Style="{StaticResource PrimaryButton}" Click="ScanGames_Click" HorizontalAlignment="Left" />
                            <TextBlock x:Name="GameStatus" Text="Seleccioná Buscar juegos para empezar." Foreground="#8FB6E5" FontSize="12" Margin="0,13,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="BIBLIOTECA DETECTADA" FontWeight="Bold" Foreground="#A6B9D2" FontSize="12" Margin="0,24,0,12" />
                    <ItemsControl x:Name="GamesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:GameEntry}">
                                <Border Style="{StaticResource PanelCard}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="16" />
                                            <TextBlock Text="{Binding Platform}" Foreground="#6FB1FF" FontSize="12" Margin="0,4,0,4" />
                                            <TextBlock Text="{Binding InstallPath}" Foreground="#93A8C1" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource BaseButton}" Content="Abrir carpeta" Tag="{Binding InstallPath}" Click="OpenGameFolder_Click" Margin="16,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- SETTINGS -->
            <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="30,22,30,25">
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Animaciones de Windows" FontWeight="Bold" FontSize="21" />
                            <TextBlock Text="Reducí las animaciones de ventanas usando una opción oficial de Windows. Se guarda el estado anterior para restaurarlo." Style="{StaticResource SecondaryText}" Margin="0,8,0,15" />
                            <TextBlock x:Name="AnimationStatus" Foreground="#8EC2FF" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,15" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnReduceAnimations" Content="Reducir animaciones" Style="{StaticResource PrimaryButton}" Click="ReduceAnimations_Click" />
                                <Button x:Name="BtnRestoreAnimations" Content="Restaurar valor anterior" Style="{StaticResource BaseButton}" Margin="11,0,0,0" Click="RestoreAnimations_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Modo Juego de Windows" FontWeight="Bold" FontSize="21" />
                            <TextBlock Text="Abrí la configuración nativa de Windows para administrar Modo Juego. OPoptimizer no modifica procesos críticos ni establece prioridades peligrosas." Style="{StaticResource SecondaryText}" Margin="0,8,0,15" />
                            <Button Content="Abrir configuración de Modo Juego" Style="{StaticResource BaseButton}" HorizontalAlignment="Left" Click="OpenGamingSettings_Click" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Código abierto, de verdad" FontWeight="Bold" FontSize="21" />
                            <TextBlock Text="OPoptimizer 1.0.0 está publicado bajo licencia MIT. Podés revisar, modificar, compilar y redistribuir el código. Sin telemetría ni conexión obligatoria." Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
                            <TextBlock Text="Tecnología: C# · WPF · .NET 8 · Windows" Foreground="#76B8FE" FontSize="12" Margin="0,13,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="#22344A" BorderThickness="0,1,0,0" Padding="30,11">
                <Grid>
                    <TextBlock Text="OPoptimizer  ·  Open Source  ·  Hecho para jugar mejor, sin humo" Foreground="#8196B2" FontSize="11" />
                    <TextBlock Text="v1.0.0" HorizontalAlignment="Right" Foreground="#6985A8" FontSize="11" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
